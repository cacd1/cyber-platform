rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Check if user is authenticated (Anonymous or Registered)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is Admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'nb2@admin.com';
    }

    // Helper: Check if user is NOT an anonymous student (i.e. is Admin or Rep)
    function isAuthorizedUploader() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /{allPaths=**} {
      // 1. READ: Must be authenticated (Student with Code OR Rep OR Admin)
      allow read: if isAuthenticated();

      // 2. WRITE/DELETE: Only Admins and Representatives can write/delete. Students (Anonymous) cannot.
      allow write: if isAuthorizedUploader() && request.resource.size < 10 * 1024 * 1024; // 10MB limit enforced
    }
  }
}
